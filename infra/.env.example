# ─── App ───────────────────────────────────────
APP_ENV=dev
APP_PORT=80

# ─── PostgreSQL ────────────────────────────────
POSTGRES_USER=namotai
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=namotai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Media ─────────────────────────────────────
MEDIA_DIR=/data/media
MAX_FILE_SIZE_MB=100
MAX_VIDEO_DURATION_SEC=7200

# ─── Rate limit ────────────────────────────────
RATE_LIMIT_PER_DAY=5

# ─── Cloud.ru ──────────────────────────────────
CLOUD_RU_API_KEY=
CLOUD_RU_BASE_URL=
WHISPER_MODEL=
LLM_MODEL=

# ─── Frontend ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost